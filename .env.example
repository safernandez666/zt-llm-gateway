# Copiá a .env. Todo tiene default: la POC arranca sin tocar nada.

POSTGRES_PASSWORD=ztpass
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=apppass

KEYCLOAK_ADMIN_PASSWORD=admin

LITELLM_MASTER_KEY=sk-zt-master
LITELLM_SALT_KEY=sk-zt-salt

LANGFUSE_PUBLIC_KEY=pk-lf-zt-poc
LANGFUSE_SECRET_KEY=sk-lf-zt-poc
LANGFUSE_NEXTAUTH_SECRET=nextauth-secret-cambiar
LANGFUSE_SALT=salt-cambiar
LANGFUSE_USER_PASSWORD=langfuse123

# Modelo on-prem que se baja en el seed.
LOCAL_MODEL=llama3.2:3b

# Motor de deteccion de prompt injection:
# Motor de detección de prompt injection:
#   heuristic -> reglas, arranca al instante
#   model     -> clasificador deberta de ProtectAI (lo baja en la 1ra llamada)
INJECTION_ENGINE=heuristic

# Key de OpenAI. Se usa en dos lugares muy distintos, y esa es la demo:
#   - orchestrator-insecure: la tiene en su propio env y le pega directo
#   - litellm:               la tiene el gateway, y el orquestador seguro no
# Sin key, los dos lados caen al modelo local y la POC igual corre entera.
OPENAI_API_KEY=

CLOUD_MODEL=gpt-4o-mini

# A qué modelo le pega el stack SIN gateway:
#   cloud -> el caso realista (todo sale al proveedor)
#   local -> para comparar el mismo modelo a ambos lados
INSECURE_TARGET=cloud
